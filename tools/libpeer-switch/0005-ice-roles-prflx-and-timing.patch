+                                                 remote->priority,
+                                                 agent->mode == AGENT_MODE_CONTROLLING);
+    pair->state = ICE_CANDIDATE_STATE_FROZEN;
+    pair->conncheck = 0;
+    agent->candidate_pairs_num++;
+  }
