 int addr_equal(const Address* a, const Address* b) {
-  // TODO
-  return 1;
+  // 0037: this used to be a stub that ALWAYS returned 1 ("// TODO").
+  //
+  // It is used now to check that a binding response really comes from the
+  // candidate the connectivity check was sent to, so it has to compare the
+  // family, the address AND the port.
+  if (!a || !b) {
+    return 0;
+  }
+  if (a->family != b->family) {
+    return 0;
+  }
+  if (a->port != b->port) {
+    return 0;
+  }
+  switch (a->family) {
+    case AF_INET6:
+      return memcmp(&a->sin6.sin6_addr, &b->sin6.sin6_addr, sizeof(a->sin6.sin6_addr)) == 0;
+    case AF_INET:
+    default:
+      return a->sin.sin_addr.s_addr == b->sin.sin_addr.s_addr;
+  }
 }
