+  RtcpHeader* header = (RtcpHeader*)packet;
+  header->version = 2;
+  header->type = RTCP_PSFB;
+  header->rc = 15;  // FMT = 15: application layer feedback (REMB)
+  header->length = htons((len / 4) - 1);
+
+  const uint32_t network_sender_ssrc = htonl(sender_ssrc);
+  memcpy(packet + 4, &network_sender_ssrc, 4);
+  // The "SSRC of media source" of a REMB is ZERO -- the streams it talks
+  // about are in the FCI list below, not here.
+  memset(packet + 8, 0, 4);
+
+  // The FCI: the "REMB" magic, the number of entries and the bit rate.
+  packet[12] = 'R';
+  packet[13] = 'E';
+  packet[14] = 'M';
+  packet[15] = 'B';
+  packet[16] = 1;  // one SSRC in the list
+  // The REMB header: n (4 bit) | e (2 bit) | r (1 bit) | e (1 bit), then the
+  // 6 bit exponent and the 18 bit mantissa.
+  packet[17] = (uint8_t)(((exponent & 0x3Fu) << 2) | ((mantissa >> 16) & 0x03u));
+  packet[18] = (uint8_t)((mantissa >> 8) & 0xffu);
+  packet[19] = (uint8_t)(mantissa & 0xffu);
+
+  const uint32_t network_media_ssrc = htonl(media_ssrc);
+  memcpy(packet + 20, &network_media_ssrc, 4);
+
+  return len;
+}
