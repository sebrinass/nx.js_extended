+// 0040: build a REMB packet.
+//
+// See rtcp.h for the layout.  The bit rate is carried as an 18 bit mantissa
+// and a 6 bit exponent: `bitrate = mantissa << exponent`.
+//
+// The mantissa is normalized first: the value is shifted right until it
+// fits into 18 bits, and the number of shifts becomes the exponent.  The
+// result is the bit rate rounded DOWN to the resolution of the encoding.
+int rtcp_get_remb(uint8_t* packet, int len, uint32_t sender_ssrc,
+                  uint32_t media_ssrc, uint32_t bitrate_bps) {
+  if (packet == NULL || len < 24) {
+    return -1;
+  }
+  if (bitrate_bps == 0) {
+    return -1;  // a REMB of zero would tell the sender to stop sending
+  }
+
+  memset(packet, 0, len);
+
+  uint32_t mantissa = bitrate_bps;
+  uint32_t exponent = 0;
+  while (mantissa > 0x3FFFFu && exponent < 63) {
+    mantissa >>= 1;
+    exponent++;
+  }
+  if (mantissa == 0) {
+    mantissa = 1;
+  }
