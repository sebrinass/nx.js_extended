Switch specific fixes for libpeer (extern/libpeer).

extern/libpeer is a git SUBMODULE (patch 0003 brings it in), so its sources
must not be edited in place: the next `git submodule update` would throw the
changes away.  This patch is therefore applied to the checked out tree by
tools/apply-libpeer-switch-patches.sh, right before libpeer is built.

What it fixes (the Switch/xbox WebRTC port pit list):

  1. ICE host candidate: the Switch has no getifaddrs(), so the address now
     comes from the engine (nx_libpeer_get_local_ipv4() -> libnx
     nifmGetCurrentIpAddress()).  The gethostid() fallback rejects
     loopback and link local, because gethostid() answers INADDR_LOOPBACK
     when its nifm query fails.
  2. Inbound packet buffers: CONFIG_PACKET_BUFFER_SIZE (2048) replaces
     CONFIG_MTU (1300) for the UDP receive buffer, the DTLS read buffer, the
     SCTP packet buffer and the RTP reorder slot.  A 1300 byte receive
     buffer truncated SRTP protected H.264 packets, so the authentication
     tag no longer matched and the packets were dropped.
  3. ICE tie-breaker: generated per session, never 0 (strict peers reject
     that) and written in NETWORK byte order (RFC 8445 section 5) instead
     of the raw host order u64.
  4. libsrtp uses mbedTLS for its AES / HMAC, so the binary carries one
     crypto stack instead of two.
  5. The DTLS write result is normalised to the usrsctp output callback
     contract (0 = sent, positive errno = failed) and the raw mbedTLS value
     is kept for the self test.  The retry loop is bounded now, it used to
     be able to spin forever.
  6. / 7. usrsctp already runs with the full stack (SACK, retransmission,
     congestion control, PR-SCTP) and the DataChannel policy already sets
     SCTP_UNORDERED + SCTP_PR_SCTP_RTX, so nothing had to change there.

Note: the blank context lines below are empty instead of a single space.
git apply accepts both, and this way the patch file itself carries no
trailing whitespace.
diff --git a/CMakeLists.txt b/CMakeLists.txt
index ac7de5f..47a912f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -100,15 +100,30 @@ if(NOT INPUT_CONTENT MATCHES "OpenNOW Switch mbedtls overrides")
   file(WRITE "${_OPENNOW_MBEDTLS_CONFIG}" "${MODIFIED_CONTENT}\n${_OPENNOW_MBEDTLS_MARKER}\n#define MBEDTLS_NO_PLATFORM_ENTROPY\n#define MBEDTLS_TEST_NULL_ENTROPY\n#undef MBEDTLS_TIMING_C\n#undef MBEDTLS_NET_C\n")
 endif()

+# libsrtp uses mbedTLS for its AES / HMAC instead of its own built-in
+# implementation.  That keeps ONE crypto stack in the binary: the very same
+# mbedTLS 3.4.0 that runs the DTLS handshake also runs the SRTP encryption,
+# instead of shipping a second AES implementation next to it.
+#
+# The mbedTLS paths are passed explicitly because the cross build's
+# find_path() / find_library() only look inside the toolchain root and would
+# not find dist/.  libsrtp therefore has to be built AFTER mbedtls, otherwise
+# those paths do not exist yet -- add_dependencies() enforces that order.
 ExternalProject_Add(srtp2
   SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/third_party/libsrtp
   CMAKE_ARGS
     -DCMAKE_POLICY_VERSION_MINIMUM=3.5
     -DCMAKE_POSITION_INDEPENDENT_CODE=ON
     -DTEST_APPS=off
+    -DENABLE_MBEDTLS=ON
+    -DMBEDTLS_INCLUDE_DIRS=${CMAKE_BINARY_DIR}/dist/include
+    -DMBEDTLS_LIBRARY=${CMAKE_BINARY_DIR}/dist/lib/libmbedtls.a
+    -DMBEDX509_LIBRARY=${CMAKE_BINARY_DIR}/dist/lib/libmbedx509.a
+    -DMBEDCRYPTO_LIBRARY=${CMAKE_BINARY_DIR}/dist/lib/libmbedcrypto.a
     -DCMAKE_INSTALL_PREFIX=${CMAKE_BINARY_DIR}/dist
     -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
 )
+add_dependencies(srtp2 mbedtls)

 ExternalProject_Add(usrsctp
   SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/third_party/usrsctp
diff --git a/src/agent.c b/src/agent.c
index 8b29ee3..a0fad16 100644
--- a/src/agent.c
+++ b/src/agent.c
@@ -33,6 +33,32 @@ void agent_clear_candidates(Agent* agent) {
   agent->binding_responses_received = 0;
 }

+// Generate the ICE tie-breaker for this session.
+//
+// RFC 8445 section 5 requires it to be a non-zero 64-bit value, and it has
+// to be stable for the lifetime of the session.  The old code used a fixed
+// 0, which strict peers (the Xbox family, for one) reject outright.
+//
+// The value is seeded from the wall clock plus the monotonic clock so two
+// sessions on the same boot do not end up with the same tie-breaker, and
+// then mixed through splitmix64 so the low bits are not simply the clock.
+static uint64_t agent_generate_tie_breaker(void) {
+  uint64_t seed = (uint64_t)ports_get_epoch_time() * 1000000u +
+                   (uint64_t)(ports_get_monotonic_time_us() % 1000000u);
+  uint64_t value = seed;
+  for (int i = 0; i < 4; i++) {
+    value += 0x9E3779B97F4A7C15ULL;
+    uint64_t z = value;
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    value = z ^ (z >> 31);
+  }
+  if (value == 0) {
+    value = 1;
+  }
+  return value;
+}
+
 int agent_create(Agent* agent) {
   int ret;
   if ((ret = udp_socket_open(&agent->udp_sockets[0], AF_INET, 0)) < 0) {
@@ -52,6 +78,7 @@ int agent_create(Agent* agent) {
   agent_clear_candidates(agent);
   memset(agent->remote_ufrag, 0, sizeof(agent->remote_ufrag));
   memset(agent->remote_upwd, 0, sizeof(agent->remote_upwd));
+  agent->tie_breaker = agent_generate_tie_breaker();
   return 0;
 }

@@ -332,7 +359,13 @@ static void agent_create_binding_response(Agent* agent, StunMessage* msg, Addres
 }

