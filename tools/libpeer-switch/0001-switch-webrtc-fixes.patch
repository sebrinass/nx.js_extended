diff --git a/src/sctp.c b/src/sctp.c
index 4bd438a..b9fdee9 100644
--- a/src/sctp.c
+++ b/src/sctp.c
@@ -27,6 +27,25 @@ static atomic_int sctp_diagnostics_enabled;
 typedef void (*SctpDiagnosticCallback)(const char*);
 static _Atomic(SctpDiagnosticCallback) sctp_diagnostic_callback;

+// Convert an mbedTLS write result into the errno style contract that
+// usrsctp's conn_output callback uses: 0 means "sent", a POSITIVE errno
+// means "failed".
+//
+// mbedTLS returns the number of bytes written on success and a negative error
+// code on failure.  Handing the byte count straight back makes usrsctp treat
+// every emitted packet as a send error even though DTLS delivered it to the
+// network, and handing back a negative value violates the contract too.
+static int sctp_dtls_write_errno(int write_result) {
+  if (write_result >= 0) {
+    return 0;
+  }
+  if (write_result == MBEDTLS_ERR_SSL_WANT_WRITE ||
+      write_result == MBEDTLS_ERR_SSL_WANT_READ) {
+    return EAGAIN;
+  }
+  return EIO;
+}
+
 void sctp_set_diagnostic_callback(void (*callback)(const char*)) {
   atomic_store(&sctp_diagnostic_callback, callback);
 }
