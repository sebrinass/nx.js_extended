diff --git a/src/config.h b/src/config.h
index 1daf171..d75816e 100644
--- a/src/config.h
+++ b/src/config.h
@@ -7,6 +7,21 @@
 #define SCTP_MTU (1200)
 #define CONFIG_MTU (1300)

+// Size of the INBOUND packet buffers.
+//
+// CONFIG_MTU is the OUTBOUND MTU: it is what we advertise and what our own
+// packets are sized to.  An inbound RTP packet is bigger than that, because
+// the sender's payload plus the 10-byte SRTP header plus the 10-byte
+// authentication tag have to fit in one datagram.  With a 1300-byte receive
+// buffer such a datagram is truncated, the SRTP authentication tag no longer
+// matches, and the packet is dropped as if it had been lost.
+//
+// 2048 is the value the Switch/xbox WebRTC ports use: it covers a 1500-byte
+// RTP payload plus SRTP overhead with room to spare.
+#ifndef CONFIG_PACKET_BUFFER_SIZE
+#define CONFIG_PACKET_BUFFER_SIZE (2048)
+#endif
+
 #ifndef CONFIG_USE_LWIP
 #define CONFIG_USE_LWIP 0
 #endif
diff --git a/src/dtls_srtp.c b/src/dtls_srtp.c
index 9caf5dd..57f6022 100644
--- a/src/dtls_srtp.c
+++ b/src/dtls_srtp.c
@@ -15,6 +15,10 @@
 #include "socket.h"
 #include "utils.h"

+// How often dtls_srtp_write() retries a mbedTLS "would block" answer before
+// it gives up and reports the error.  The retry used to be unbounded.
+#define DTLS_SRTP_WRITE_MAX_RETRIES 8
+
 int dtls_srtp_udp_send(void* ctx, const uint8_t* buf, size_t len) {
   DtlsSrtp* dtls_srtp = (DtlsSrtp*)ctx;
   UdpSocket* udp_socket = (UdpSocket*)dtls_srtp->user_data;
@@ -486,13 +490,29 @@ void dtls_srtp_reset_session(DtlsSrtp* dtls_srtp) {
   dtls_srtp->state = DTLS_SRTP_STATE_INIT;
 }

+// The raw mbedTLS return value of the last dtls_srtp_write() call.
+// See dtls_srtp_get_last_write_result() in dtls_srtp.h.
+static int g_dtls_srtp_last_write_result = 0;
+
+int dtls_srtp_get_last_write_result(void) {
+  return g_dtls_srtp_last_write_result;
+}
+
 int dtls_srtp_write(DtlsSrtp* dtls_srtp, const unsigned char* buf, size_t len) {
-  int ret;
+  int ret = 0;
+  int attempt;

-  do {
+  // mbedTLS asks for a retry when the socket is not ready yet.  The retry
+  // used to be unbounded, which can spin forever inside the engine's loop
+  // thread and hang the whole page.  Cap it and hand the last error back.
+  for (attempt = 0; attempt < DTLS_SRTP_WRITE_MAX_RETRIES; attempt++) {
     ret = mbedtls_ssl_write(&dtls_srtp->ssl, buf, len);
+    if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
+      break;
+    }
+  }

-  } while (ret == MBEDTLS_ERR_SSL_WANT_READ || ret == MBEDTLS_ERR_SSL_WANT_WRITE);
+  g_dtls_srtp_last_write_result = ret;
   return ret;
 }

