   char ack = DATA_CHANNEL_ACK;
   stream->ack_pending = sctp_outgoing_data(sctp, &ack, 1, PPID_CONTROL, sid) < 0;
+  /* 0014: the channel is open NOW -- the stream table above was filled by
+   *   sctp_record_open(), so the sid and the label both exist.  Tell the
+   *   owner: the association-up callback (sctp->onopen) fired long before
+   *   this point and had no sid to report. */
+  if (sctp->ondatachannel)
+    sctp->ondatachannel(sid, stream->label, sctp->userdata);
 }
 
