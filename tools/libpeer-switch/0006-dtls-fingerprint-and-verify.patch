+             dtls_srtp->remote_fingerprint_alg[0] ? dtls_srtp->remote_fingerprint_alg : "?",
+             dtls_srtp_bounded_len(dtls_srtp->remote_fingerprint, DTLS_SRTP_FINGERPRINT_LENGTH),
+             expected_prefix);
+      } else {
