@@ -1091,9 +1131,12 @@ int sctp_create_association(Sctp* sctp, DtlsSrtp* dtls_srtp) {
   } while (0);
 
   const int setup_errno = errno;
+  if (ret < 0)
+    sctp->create_fail_reason = SCTP_CREATE_FAIL_SETUP_FAILED;
   pthread_mutex_unlock(&sctp_runtime_mutex);
   if (ret < 0) {
-    sctp_diag_log("create_failed step=%s errno=%d", setup_step, setup_errno);
+    sctp_diag_log("create_failed step=%s errno=%d reason=%s", setup_step, setup_errno,
