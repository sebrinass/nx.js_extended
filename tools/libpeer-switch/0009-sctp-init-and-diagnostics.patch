+/* 0041: the stable name of a SctpCreateFailReason.  The engine puts this
+ * string straight into its getStats blob, so it must not change. */
+const char* sctp_create_fail_reason_name(int reason) {
+  switch (reason) {
+    case SCTP_CREATE_FAIL_NONE:
+      return "none";
+    case SCTP_CREATE_FAIL_RUNTIME_NOT_INITIALIZED:
+      return "runtime_not_initialized";
+    case SCTP_CREATE_FAIL_SOCKET_PRESENT:
+      return "socket_present";
+    case SCTP_CREATE_FAIL_ALLOCATION_FAILED:
+      return "allocation_failed";
+    case SCTP_CREATE_FAIL_SOCKET_FAILED:
+      return "socket_failed";
+    case SCTP_CREATE_FAIL_SETUP_FAILED:
+      return "setup_failed";
+    case SCTP_CREATE_FAIL_INVALID_CONTEXT:
+      return "invalid_context";
+    default:
+      return "unknown";
+  }
+}
