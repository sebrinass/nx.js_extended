diff --git a/src/peer_connection.h b/src/peer_connection.h
index b4d7bb5..d49938a 100644
--- a/src/peer_connection.h
+++ b/src/peer_connection.h
@@ -409,6 +409,48 @@ int peer_connection_get_diagnostics(PeerConnection* pc, PeerConnectionDiagnostic
 
